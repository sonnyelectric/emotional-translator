# Copy to backend/.env for a live run. Default replay setup skips credentials and weights.
ELEVENLABS_API_KEY=
SCRIBE_MODEL_ID=scribe_v3_live
SCRIBE_COMMIT_STRATEGY=vad
SCRIBE_VAD_SILENCE_SECS=0.65
# unknown | connection | segment. Run scripts/smoke_scribe.py with the key to determine it.
# unknown (default) keeps captions but places no clouds until the basis is proven.
# segment = plan B: only the first commit of each connection gets clouds (Pause/Resume per line).
SCRIBE_TIMESTAMP_BASIS=unknown
# Opt-in: record each live session's emitted events (text, timestamps, scores; never audio)
# as a replay fixture plus a "recorded live session" manifest entry when the session ends.
# Leave empty to store nothing. Relative paths resolve from the repo root.
# RECORD_SESSION_EVENTS=shared/fixtures/replay_live_recorded.jsonl
AUDIO_SAMPLE_RATE=16000
EMOTION_MODEL_ID=iic/emotion2vec_plus_large
EMOTION_WINDOW_SECONDS=2.0
EMOTION_HOP_SECONDS=1.0

# Starting values from the TDD. Record any measured tuning in docs/live/benchmark.md.
EMOTION_SMOOTHING_ALPHA=0.55
EMOTION_VISIBLE_SUPPORT=0.36
EMOTION_FAINT_SUPPORT=0.20
EMOTION_NEUTRAL_SUPPRESS=0.60
# Per-label weights used only to choose the shown emotion (raw scores are still reported).
EMOTION_LABEL_GAINS=angry=1.3,disgusted=1.6,fearful=1.6,happy=0.6,sad=1.3,surprised=1.4,neutral=0.8,other=0.8,unknown=0.7
EMOTION_BLEND_SECONDARY_MIN=0.30
EMOTION_BLEND_GAP_MAX=0.15
EMOTION_HYSTERESIS=0.06
MAX_PENDING_EMOTION_WINDOWS=2
PHRASE_GAP_MS=350

# Backend only. Change in concert with the local frontend origin.
ALLOWED_ORIGIN=http://localhost:5173
# Hosted: comma-separated exact origins (replaces the localhost default unless ALLOWED_ORIGIN
# is also set) and an optional full-match regex, e.g. for Vercel preview URLs:
# ALLOWED_ORIGINS=https://my-app.vercel.app
# ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+-team\.vercel\.app$
# Public-endpoint guards: per-session wall-clock limit (default 300) and an optional
# in-memory per-UTC-day live cap.
# SESSION_MAX_SECONDS=300
# LIVE_DAILY_MAX_SECONDS=3600
# Dev tuning route (/ws/dev/tune); scripts/demo_live.sh sets it for local runs.
# ENABLE_TUNE_ROUTE=1
SESSION_DRAIN_TIMEOUT_MS=1200
PHRASE_LOOKAHEAD_MS=2000
RETRY_MAX_ATTEMPTS=5

# Optional local path outside the repository. Validate the source and license before downloading.
EMOTION_MODEL_CACHE_DIR=
