{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotional-translator.invalid/schemas/v1/event-envelope.schema.json",
  "title": "Common v1 server event envelope",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "session_id",
    "seq",
    "issued_at_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 100
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/positiveInteger"
    },
    "issued_at_ms": {
      "$ref": "common.schema.json#/$defs/nonnegativeInteger"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
