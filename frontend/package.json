{
  "name": "emotional-translator-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:replay": "tsc --noEmit -p tsconfig.json && vite build --mode replay",
    "preview": "vite preview",
    "preview:replay": "vite preview --mode replay",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check:fixtures": "vite-node scripts/fixture_sentiment.ts",
    "test:contract": "vitest run tests/contracts.test.ts",
    "install:browsers": "playwright install chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "ajv": "8.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
